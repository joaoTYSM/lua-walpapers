{
  "audioReact": {
    "type": "checkbox",
    "value": true,
    "text": "Audio reactive"
  },
  "sensitivity": {
    "type": "slider",
    "value": 1,
    "min": 0.2,
    "max": 3,
    "step": 0.1,
    "text": "Bass sensitivity"
  },
  "splatRadius": {
    "type": "slider",
    "value": 0.3,
    "min": 0.1,
    "max": 1,
    "step": 0.05,
    "text": "Splat size"
  },
  "curl": {
    "type": "slider",
    "value": 28,
    "min": 0,
    "max": 60,
    "step": 1,
    "text": "Swirl"
  },
  "dissipation": {
    "type": "slider",
    "value": 1.1,
    "min": 0.2,
    "max": 4,
    "step": 0.1,
    "text": "Fade speed"
  },
  "colorSpeed": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 5,
    "step": 0.1,
    "text": "Color shift"
  },
  "mouseTrail": {
    "type": "checkbox",
    "value": true,
    "text": "Mouse trail (hold left button and drag)"
  },
  "hoverFlow": {
    "type": "checkbox",
    "value": false,
    "text": "Smoke follows cursor without clicking"
  },
  "trailSize": {
    "type": "slider",
    "value": 0.35,
    "min": 0.1,
    "max": 1.2,
    "step": 0.05,
    "text": "Trail size"
  },
  "trailPower": {
    "type": "slider",
    "value": 1,
    "min": 0.2,
    "max": 3,
    "step": 0.1,
    "text": "Trail force"
  },
  "quality": {
    "type": "dropdown",
    "value": 1,
    "items": [
      "Low",
      "Medium",
      "High"
    ],
    "text": "Quality"
  }
}